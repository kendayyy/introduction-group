# Copy to `.env.local` for local development.
# Names and comments only. Do not put secrets or real company data here.

# This repository uses fictional Web2Go content for the demo. Keep production
# release disabled until real approved content is supplied.
CONTENT_MODE=demo

# Public canonical origin. Leave empty until the domain is known.
NEXT_PUBLIC_SITE_URL=

# Set to true only after investor relations is approved for launch.
NEXT_PUBLIC_INVESTOR_RELATIONS_ENABLED=

# Sanity project connection. Leave empty to use the local placeholder content.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=
SANITY_REVALIDATE_SECRET=

# Cloudflare Turnstile. The form stays closed until both values exist.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics starts only after consent and a real configuration id.
# Provider must be ga4 or matomo when used.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=

# Set to true only when the placeholder scan is clean and indexing is approved.
ALLOW_INDEXING=
